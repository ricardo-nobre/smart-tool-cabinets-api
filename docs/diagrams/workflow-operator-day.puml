@startuml
|Operador|
start
:Autenticar no armário;

|Sistema|
:Criar CabinetAccess;
:Registar snapshot BEFORE;

|Operador|
:Retirar ou devolver ferramentas;

|Sistema|
:Registar snapshot AFTER;
:Calcular delta;

if (Ferramenta retirada?) then (sim)
  :Criar ToolAssignment ACTIVE;
endif

if (Ferramenta devolvida ao armário de origem?) then (sim)
  :Marcar ToolAssignment RETURNED;
elseif (Ferramenta detetada noutro armário?) then (sim)
  :Marcar ToolAssignment PENDING_REVIEW;
endif

:Fechar CabinetAccess;
:Executar end-of-day-check quando solicitado;

if (Restam ACTIVE ou PENDING_REVIEW?) then (sim)
  :allowExit=false;
  |Supervisor|
  :Criar SupervisorResolution para uma assignment;
  |Sistema|
  :Marcar essa assignment como RESOLVED;
  :Num novo end-of-day-check,\nallowExit é recalculado;
else (não)
  :allowExit=true;
endif

stop
@enduml
